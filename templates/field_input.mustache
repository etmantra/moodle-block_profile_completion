{{!
    @template block_profile_completion/field_input

    The single form control shown inside the inline-edit modal.

    Exactly one of istextarea, isselect and istext is true; they are computed
    in the AMD module from the chip's data-type.

    Context variables required for this template:
    * label string - Visible label for the control.
    * istextarea bool - Render a textarea.
    * isselect bool - Render a select.
    * istext bool - Render a single-line text input.
    * current string - The field's current value.
    * choices array - For a select: value, label, selected.

    Example context (json):
    {
        "label": "Country",
        "istextarea": false,
        "isselect": true,
        "istext": false,
        "current": "GB",
        "choices": [
            {"value": "GB", "label": "United Kingdom", "selected": true},
            {"value": "IN", "label": "India", "selected": false}
        ]
    }
}}
<div class="pcb-modal-field">
    <label for="pcb-field-input-{{uniqid}}">{{label}}</label>
    {{#istextarea}}
        <textarea class="form-control pcb-input" id="pcb-field-input-{{uniqid}}" data-pcb-modal-input
                  rows="4">{{current}}</textarea>
    {{/istextarea}}
    {{#isselect}}
        <select class="form-select pcb-input" id="pcb-field-input-{{uniqid}}" data-pcb-modal-input>
            <option value="">{{#str}} choosedots {{/str}}</option>
            {{#choices}}
                <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
            {{/choices}}
        </select>
    {{/isselect}}
    {{#istext}}
        <input type="text" class="form-control pcb-input" id="pcb-field-input-{{uniqid}}"
               data-pcb-modal-input value="{{current}}">
    {{/istext}}
</div>
