{{!
    @template block_profile_completion/interest_pills

    The user's interest tags, as removable pills.

    Included by block_content.mustache on first render and re-rendered by the
    AMD module after a tag is added, so both paths produce identical markup.

    Context variables required for this template:
    * interests array - Objects with rawname (sent to the server) and name
      (shown to the user).

    Example context (json):
    {
        "interests": [
            {"rawname": "Cinematography", "name": "Cinematography"}
        ]
    }
}}
{{#interests}}
    <span class="pcb-pill" data-pcb-pill="{{rawname}}">{{name}}<button type="button"
        class="pcb-pill-remove" data-pcb-remove
        aria-label="{{#str}} removeinterest, block_profile_completion, {{name}} {{/str}}"><span
        aria-hidden="true">&times;</span></button></span>
{{/interests}}
