{{!
    @template block_profile_completion/mobile_view

    Read-only profile-completion summary for the Moodle App (Ionic).

    The line below switches Mustache to angle-percent delimiters, leaving double
    braces for Angular. Angle-percent for server values, double braces only for
    the translate pipe.

    Context variables required for this template:
    * pct int - Completion percentage.
    * complete bool - Whether the profile is 100% complete.
    * fullname string - The user's full name.
    * prompt string - Encouragement line, or the complete message.
    * missing array - Objects with a label for each incomplete field.
    * hasmissing bool - Whether any field is incomplete.
    * hasoverflow bool - Whether more fields are missing than are listed.
    * overflow int - How many further fields are missing.
    * interests array - Objects with a name for each interest tag.
    * hasinterests bool - Whether the user has any interest tags.
    * editurl string - URL of the profile edit form.

    Example context (json):
    {
        "pct": 60,
        "complete": false,
        "fullname": "Ada Lovelace",
        "prompt": "Complete your profile.",
        "missing": [{"label": "City"}],
        "hasmissing": true,
        "hasoverflow": true,
        "overflow": 2,
        "interests": [{"name": "Maths"}],
        "hasinterests": true,
        "editurl": "https://example.com/user/edit.php?id=2"
    }
}}
{{=<% %>=}}

<ion-card class="pcb-mobile">
    <ion-card-content>
        <div class="pcb-mobile-head">
            <div class="pcb-mobile-ring" [class.complete]="<% complete %>">
                <span class="pcb-mobile-pct"><% pct %>%</span>
            </div>
            <div class="pcb-mobile-name"><% fullname %></div>
        </div>

        <%!
            ion-progress-bar takes 0..1. Rather than add another field, divide
            in the binding — Angular evaluates it.
        %>
        <ion-progress-bar value="<% pct %> / 100"
            <%#complete%>color="success"<%/complete%>></ion-progress-bar>

        <p class="pcb-mobile-prompt"><% prompt %></p>

        <%#hasmissing%>
        <div class="pcb-mobile-missing">
            <p class="pcb-mobile-label">{{ 'plugin.block_profile_completion.missingfields' | translate }}</p>
            <div class="pcb-mobile-chips">
                <%#missing%>
                <ion-chip outline="true"><ion-label><% label %></ion-label></ion-chip>
                <%/missing%>
                <%#hasoverflow%>
                <ion-chip outline="true"><ion-label>+<% overflow %></ion-label></ion-chip>
                <%/hasoverflow%>
            </div>
        </div>
        <%/hasmissing%>

        <%#hasinterests%>
        <div class="pcb-mobile-interests">
            <p class="pcb-mobile-label">{{ 'plugin.block_profile_completion.interests' | translate }}</p>
            <div class="pcb-mobile-chips">
                <%#interests%>
                <ion-chip color="primary"><ion-label><% name %></ion-label></ion-chip>
                <%/interests%>
            </div>
        </div>
        <%/hasinterests%>

        <%!
            core-link sends /user/edit.php through the app's router, which opens
            the native profile editor rather than a browser tab.
        %>
        <ion-button expand="block" fill="outline" class="pcb-mobile-edit"
                    [href]="'<% editurl %>'" core-link capture="true">
            {{ 'plugin.block_profile_completion.editprofile' | translate }}
        </ion-button>
    </ion-card-content>
</ion-card>
